            return False
            
        # Check for suspicious terms
        if any(term in salary.lower() for term in self.SUSPICIOUS_TERMS):
            return False
            
        # Check for zero values
        zero_patterns = [r'[\$₹€£]\s*0', r'[\$₹€£]\s*0[./,]0']
        if any(re.search(pattern, salary) for pattern in zero_patterns):
            return False
            
        return True
